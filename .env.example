# =============================================================================
# ProjectBuddy — environment template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git (it is listed in .gitignore)
# =============================================================================

# ── Flask ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-python-secrets

FLASK_ENV=development
FLASK_APP=app:create_app

# Local port (5001 avoids macOS AirPlay on 5000)
PORT=5001

# ── Database ───────────────────────────────────────────────────────────────────
SQLALCHEMY_DATABASE_URI=sqlite:///projectbuddy.db
# Production (PostgreSQL example):
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:5432/projectbuddy
#
# After changing models.py:
#   flask db migrate -m "describe change"
#   flask db upgrade

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Password reset ─────────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRY=3600

# ── Admin (created/updated on startup) ─────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# ── Dev mock data ──────────────────────────────────────────────────────────────
# Production: set SEED_MOCK_DATA=false
SEED_MOCK_DATA=true
MOCK_PASSWORD=Mock@123
MOCK_EMAIL_SUFFIX=@mock.projectbuddy.local

# ── GitHub OAuth (optional) ────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5001/auth/github/callback

# ── Roles ──────────────────────────────────────────────────────────────────────
FACULTY_DOMAIN=@faculty.yourdomain.com

# ── AI chatbot (optional) ────────────────────────────────────────────────────────
# Groq: https://console.groq.com — leave empty for built-in mock replies
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Anthropic fallback (only used if GROQ_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Production CORS (SocketIO) ─────────────────────────────────────────────────
# Comma-separated origins, e.g. https://yourdomain.com
# Leave empty in development (all origins allowed)
CORS_ORIGINS=

# ── Redis (rate limiting) ───────────────────────────────────────────────────────
# Required in production for multi-worker rate limiting correctness.
# Without this, each Gunicorn worker has its own counter (limits are bypassable).
# Leave empty in development — falls back to in-process memory automatically.
# Example: redis://localhost:6379/0  or  rediss://:<password>@host:6379/0
REDIS_URL=

# ── File Storage (S3 / S3-compatible) ──────────────────────────────────────────
# Leave all empty to use local disk (default for dev).
# Set AWS_S3_BUCKET to enable S3 uploads in production.
# AWS_CLOUDFRONT_URL is optional — if set, returned URLs use this CDN prefix.
# AWS_ENDPOINT_URL is optional — for S3-compatible services (Backblaze, MinIO).
AWS_S3_BUCKET=
AWS_S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_URL=
AWS_ENDPOINT_URL=

# =============================================================================
# PRODUCTION CHECKLIST — set all of these before going live
# =============================================================================
# FLASK_ENV=production
# SECRET_KEY=<64-char random hex>
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:5432/projectbuddy
# ADMIN_EMAIL=<real admin email>
# ADMIN_PASSWORD=<strong password>
# SEED_MOCK_DATA=false
# CORS_ORIGINS=https://yourdomain.com
# REDIS_URL=redis://:<password>@host:6379/0
# AWS_S3_BUCKET=<your-bucket-name>
# MAIL_USERNAME=<gmail address>
# MAIL_PASSWORD=<gmail app password>
# =============================================================================
